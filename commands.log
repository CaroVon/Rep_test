$PY - <<'EOF'   # data_manifest.json: append gemma1b_c4big_s{0,1,2} (sha256 via hashlib streaming; shape/dtype via np.load mmap; meta filtered to the key set of existing c4 entries)
import json, hashlib, numpy as np, os
orig = json.load(open("data_manifest.json"))
def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""): h.update(chunk)
    return h.hexdigest()
def entry(d):
    files = {}
    for fn in ["G.npy", "E_base.npy", "E_target.npy", "pairs.npy"]:
        a = np.load(os.path.join(d, fn), mmap_mode="r")
        files[fn] = {"sha256": sha256(os.path.join(d, fn)), "shape": list(a.shape), "dtype": str(a.dtype)}
    files["contexts.json"] = {"sha256": sha256(os.path.join(d, "contexts.json"))}
    m = json.load(open(os.path.join(d, "meta.json")))
    keep = ["model","dtype","load_in_4bit","n_pairs","logits_rel_err","seed","concept","ctx_source"]
    files["meta"] = {k: m[k] for k in keep}
    files["corpus"] = "allenai/c4 en (streaming, shuffle seed derived, 0.5 thinning)"
    files["docs_scanned"] = 10001   # derived: extract_embeddings.py:125-132 counts n_docs+1 (V4: 5000->5001); stdout not retained
    return files
for s in [0, 1, 2]: orig[f"gemma1b_c4big_s{s}"] = entry(f"data/gemma1b_c4big_s{s}")
open("data_manifest.json", "w").write(json.dumps(orig, indent=1))   # matches existing style; git diff = 147 insertions, 0 deletions
EOF
